---
pagination:
  data: books
  size: 1
  alias: book
permalink: "/go/{{ book.slug }}/index.html"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="robots" content="noindex,nofollow" />
<title>Redirecting to {{ book.title }}…</title>

<!-- Fallback redirect for users with JS disabled (3-second delay so the link is clickable). -->
<meta http-equiv="refresh" content="3;url={{ book.linkUrl }}" />

<!-- GA4: fire amazon_click event with book + source attribution BEFORE the redirect. -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.gaId }}', { send_page_view: false });

  // Parse UTM params and the original referrer so the GA event captures the surface.
  var params = new URLSearchParams(window.location.search);
  var amazonUrl = {{ book.linkUrl | dump | safe }};
  var dest = amazonUrl;
  // Forward any UTMs to Amazon (Amazon ignores them but it preserves them in browser back-button history).
  if (params.toString()) {
    dest += (amazonUrl.indexOf('?') === -1 ? '?' : '&') + params.toString();
  }

  // Storefront localization (2026-10-15): same logic as analytics.js. Email
  // and back-matter links come through /go/, and most of those clickers are
  // outside the US, so swap amazon.com for the visitor's Kindle storefront.
  var STOREFRONTS = { GB: 'co.uk', CA: 'ca', AU: 'com.au', DE: 'de', FR: 'fr', IT: 'it', ES: 'es', NL: 'nl', JP: 'co.jp', BR: 'com.br', MX: 'com.mx', IN: 'in' };
  var loc = null;
  try { loc = sessionStorage.getItem('rp_loc_v1'); } catch (err) {}
  var locReady = loc || !window.fetch ? Promise.resolve(loc) :
    fetch('https://grounds-reader.randypellegrini.workers.dev/cdn-cgi/trace')
      .then(function (r) { return r.text(); })
      .then(function (t) {
        var m = t.match(/^loc=([A-Z]{2})$/m);
        if (m) { loc = m[1]; try { sessionStorage.setItem('rp_loc_v1', loc); } catch (err) {} }
        return loc;
      })
      .catch(function () { return null; });
  function localize(url) {
    var tld = STOREFRONTS[loc];
    if (!tld) return url;
    if (!/\/(dp|gp\/product)\//.test(url)) return url; // only product pages (any slug before /dp/)
    return url.replace(/^(https?:\/\/)(www\.)?amazon\.com\//, '$1www.amazon.' + tld + '/');
  }
  var redirected = false;
  function go() {
    if (redirected) return;
    redirected = true;
    window.location.replace(localize(dest));
  }

  // Wait briefly (max 400ms) for the country lookup so the event records the
  // storefront actually used, then fire the GA event and redirect.
  Promise.race([locReady, new Promise(function (r) { setTimeout(r, 400); })]).then(function () {
    var finalUrl = localize(dest);
    var tldMatch = finalUrl.match(/amazon\.([a-z.]{2,})\//);
    gtag('event', 'amazon_click', {
      book_slug: '{{ book.slug }}',
      book_title: {{ book.title | dump | safe }},
      series_position: {{ book.seriesPosition }},
      utm_source: params.get('utm_source') || '(direct)',
      utm_medium: params.get('utm_medium') || '(none)',
      utm_campaign: params.get('utm_campaign') || '(none)',
      referrer: document.referrer || '(direct)',
      amazon_tld: tldMatch ? tldMatch[1] : 'com',
      storefront_loc: loc || '(unknown)',
      event_callback: go,
      event_timeout: 800
    });
    // Backup: redirect after 800ms even if the GA callback never fires.
    setTimeout(go, 800);
  });

  // Hard backup: never leave a visitor stranded on this page.
  setTimeout(go, 1500);
</script>

<style>
body { font-family: system-ui, -apple-system, sans-serif; max-width: 480px; margin: 80px auto; padding: 0 20px; color: #222; }
h1 { font-size: 1.2rem; margin: 0 0 8px; }
a { color: #0a5; }
.muted { color: #666; font-size: 0.9rem; }
</style>
</head>
<body>
<h1>Redirecting to {{ book.title }} on Amazon…</h1>
<p class="muted">If you aren't redirected automatically in a few seconds, <a href="{{ book.linkUrl }}">click here</a>.</p>
</body>
</html>
