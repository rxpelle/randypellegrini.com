---
pagination:
  data: books
  size: 1
  alias: book
permalink: "/review/{{ book.slug }}/index.html"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="robots" content="noindex,nofollow" />
<title>Review {{ book.title }}…</title>

<!--
  One-click review target for ebook back matter. Printed into the books, so the URL
  must stay stable forever — the ASIN is resolved here at build time, not in the
  manuscript. A book without an ASIN yet lands on its own page instead of a dead link.
-->
<meta http-equiv="refresh" content="3;url={{ book.reviewUrl }}" />

<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.gaId }}', { send_page_view: false });

  var params = new URLSearchParams(window.location.search);
  var dest = {{ book.reviewUrl | dump | safe }};

  gtag('event', 'review_click', {
    book_slug: '{{ book.slug }}',
    book_title: {{ book.title | dump | safe }},
    series_position: {{ book.seriesPosition }},
    utm_source: params.get('utm_source') || '(direct)',
    utm_medium: params.get('utm_medium') || '(none)',
    utm_campaign: params.get('utm_campaign') || '(none)',
    referrer: document.referrer || '(direct)',
    event_callback: function () { window.location.replace(dest); },
    event_timeout: 800
  });

  setTimeout(function () { window.location.replace(dest); }, 800);
</script>

<style>
body { font-family: system-ui, -apple-system, sans-serif; max-width: 480px; margin: 80px auto; padding: 0 20px; color: #222; }
h1 { font-size: 1.2rem; margin: 0 0 8px; }
a { color: #0a5; }
.muted { color: #666; font-size: 0.9rem; }
</style>
</head>
<body>
<h1>Taking you to the review page for {{ book.title }}…</h1>
<p class="muted">Thank you — reviews are how readers find these books. If you aren't redirected in a few seconds, <a href="{{ book.reviewUrl }}">click here</a>.</p>
</body>
</html>
