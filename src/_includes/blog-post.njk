---
layout: base.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},{% if date %}
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ (updated or date) | isoDate }}",{% endif %}
  "image": "{{ ogImage | default(site.url + '/assets/book-cover.jpg') }}",
  "wordCount": "{{ content | wordCount }}",
  "author": { "@id": "https://randypellegrini.com/#author" },
  "publisher": { "@id": "https://randypellegrini.com/#author" },
  "url": "{{ ogUrl | default(site.url + page.url) }}",
  "mainEntityOfPage": "{{ ogUrl | default(site.url + page.url) }}",
  "isPartOf": {
    "@type": "Blog",
    "name": "The Architecture of Survival Blog",
    "url": "https://randypellegrini.com/blog/"
  }
}
</script>
{%- set _items = content | listItems %}
{%- if _items.length >= 3 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ title | dump | safe }},
  "url": "{{ ogUrl | default(site.url + page.url) }}",
  "numberOfItems": {{ _items.length }},
  "itemListOrder": "https://schema.org/ItemListOrderAscending",
  "itemListElement": [
    {%- for it in _items %}
    { "@type": "ListItem", "position": {{ it.position }}, "name": {{ it.name | dump | safe }} }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{%- endif %}
<div class="article-container">
  <div class="article-header reveal">
    <p class="eyebrow">{{ bookTag }} &mdash; Essay {{ number }} of {{ collections.blog | length }}</p>
    <h1>{{ heading | default(title) | safe }}</h1>
    <p class="article-meta">By Randy Pellegrini{% if date %} · <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% endif %}{% if updated %} · Updated <time datetime="{{ updated | isoDate }}">{{ updated | readableDate }}</time>{% endif %}</p>
  </div>

  <div class="article-body reveal delay-1">
    {{ content | safe }}
  </div>

  <div class="article-email-cta reveal delay-2">
    <h3>Get series updates</h3>
    <p>New book releases, research notes, and dispatches from <em>The Architecture of Survival</em> &mdash; straight to your inbox.</p>
    <form class="signup" data-newsletter="true">
      <label class="sr-only" for="blog-email">Email address</label>
      <input id="blog-email" name="email" type="email" placeholder="you@email.com" required aria-label="Email address" />
      <button class="button" type="submit"><span>Subscribe</span></button>
    </form>
    <div class="form-messages" style="display: none;"></div>
    <p class="form-note">Plus series updates. No spam. Unsubscribe anytime.</p>
  </div>

  <div class="article-cta reveal delay-2">
    {%- set ctaBook = null %}
    {%- if bookTag and bookTag.slice(0, 5) == "Book " %}
      {%- set ctaBook = books[(bookTag.slice(5, 6) | int) - 1] %}
    {%- endif %}
    {%- set ctaBookTitle = ctaBook.title if ctaBook else "The Aethelred Cipher" %}
    <h3>{{ ctaTitle | default("Read " + ctaBookTitle) }}</h3>
    <p>{{ ctaText | safe }}</p>
    {%- if ctaButtonUrl %}
    <a class="button" href="{{ ctaButtonUrl }}" target="_blank" rel="noopener noreferrer">{{ ctaButtonText | default("Get your copy") }} &rarr;</a>
    {%- elif ctaBook %}
    {%- if ctaBook.amazonUrl %}
    <a class="button" href="{{ ctaBook.amazonUrl }}" target="_blank" rel="noopener noreferrer" data-track="amazon_click" data-book="book{{ ctaBook.seriesPosition }}" data-source="blog_cta">Get Book {{ ctaBook.seriesPosition }} &rarr;</a>
    {%- else %}
    <a class="button" href="{{ ctaBook.pageUrl }}" data-track="notify_click" data-book="book{{ ctaBook.seriesPosition }}" data-source="blog_cta">Coming {{ ctaBook.releaseLabel }} &mdash; learn more &rarr;</a>
    {%- endif %}
    {%- else %}
    <a class="button" href="{{ site.amazonUrl }}" target="_blank" rel="noopener noreferrer">{{ ctaButtonText | default("Get your copy") }} &rarr;</a>
    {%- endif %}
    <p style="margin-top: 12px;"><a class="inline-link" href="{{ ctaBook.pageUrl if ctaBook else '/the-aethelred-cipher/' }}">More about {{ ctaBookTitle }} &rarr;</a></p>
  </div>

  {%- if bookTag == "Writing & Tools" %}
  <div class="article-cta tools-signup reveal delay-2">
    <h3>Free Tools for Self-Published Authors</h3>
    <p>I'm building open-source software that replaces the expensive tools indie authors shouldn't have to pay for. Sign up to hear about new releases.</p>
    <form class="signup" data-newsletter="true">
      <label class="sr-only" for="tools-email">Email address</label>
      <input id="tools-email" name="email" type="email" placeholder="you@email.com" required aria-label="Email address" />
      <button class="button" type="submit"><span>Get notified</span></button>
    </form>
    <div class="form-messages" style="display: none;"></div>
    <p class="form-note">No spam. Just tool launches. Unsubscribe anytime.</p>
  </div>
  {%- endif %}

  <div class="grounds-blog-cta reveal delay-2">
    <a href="/read-your-grounds/" class="grounds-blog-cta-link">
      <span class="grounds-blog-cta-icon">&#9752;</span>
      <span>
        <strong>What do your coffee grounds reveal?</strong>
        <span class="grounds-blog-cta-sub">Upload a photo of your cup and receive a free AI-powered tasseography reading.</span>
      </span>
      <span class="grounds-blog-cta-arrow">&rarr;</span>
    </a>
  </div>

  {%- set _related = collections.blog | relatedPosts(page.url) -%}
  {%- if _related.length > 0 %}
  <div class="related-essays reveal delay-2">
    <h3>Keep reading</h3>
    <div class="related-grid">
      {%- for post in _related %}
      <a href="{{ post.url }}" class="related-card">
        <span class="related-number">{{ post.data.number | padStart(2) }}</span>
        {% if post.data.bookTag %}<span class="related-book-tag">{{ post.data.bookTag }}</span>{% endif %}
        <strong>{{ post.data.title }}</strong>
        <span class="related-excerpt">{{ post.data.excerpt | truncate(80) }}</span>
      </a>
      {%- endfor %}
    </div>
    <a href="/blog/" class="related-all">View all essays &rarr;</a>
  </div>
  {%- endif %}

  <div class="article-nav">
    {% if prevPost %}<a href="{{ prevPost }}">&larr; {{ prevTitle }}</a>{% endif %}
    {% if nextPost %}<a href="{{ nextPost }}">{{ nextTitle }} &rarr;</a>{% else %}<a href="/blog/">All posts &rarr;</a>{% endif %}
  </div>
</div>
