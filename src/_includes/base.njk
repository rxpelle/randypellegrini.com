<!doctype html>
<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      var loc = window.location.pathname;
      if (loc.endsWith('.html')) { loc = loc.replace(/\.html$/, '/'); }
      gtag('config', '{{ site.gaId }}', { page_path: loc });
    </script>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://*.googletagmanager.com https://script.google.com https://script.googleusercontent.com https://grounds-reader.randypellegrini.workers.dev; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://script.google.com;" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="138C63DAD6DE37AB98C15038258DF9EA" />
    <title>{% if fullTitle %}{{ fullTitle }}{% else %}{{ title }} | Randy Pellegrini{% endif %}</title>
    {% if description %}<meta name="description" content="{{ description }}" />{% endif %}
    {%- set _ogTitle = ogTitle or title or fullTitle -%}
    {%- set _ogDesc = ogDescription or description -%}
    <meta property="og:title" content="{{ _ogTitle }}" />
    <meta property="og:description" content="{{ _ogDesc }}" />
    <meta property="og:type" content="{{ ogType | default('website') }}" />
    <meta property="og:url" content="{{ ogUrl | default(site.url + page.url) }}" />
    <meta property="og:site_name" content="Randy Pellegrini" />
    <meta property="og:image" content="{{ ogImage | default(site.url + '/assets/book-cover.jpg') }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rxpelle" />
    <meta name="twitter:creator" content="@rxpelle" />
    <meta name="twitter:title" content="{{ _ogTitle }}" />
    <meta name="twitter:description" content="{{ _ogDesc }}" />
    <meta name="twitter:image" content="{{ ogImage | default(site.url + '/assets/book-cover.jpg') }}" />
    <link rel="canonical" href="{{ ogUrl | default(site.url + page.url) }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Public+Sans:wght@300;400;600&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="alternate" type="application/atom+xml" title="Randy Pellegrini" href="/feed.xml" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://randypellegrini.com/#website",
          "name": "Randy Pellegrini | Official Site",
          "url": "https://randypellegrini.com",
          "description": "Official author website for Randy Pellegrini. The Architecture of Survival - an 8-book epic spanning 3,200 years.",
          "author": { "@id": "https://randypellegrini.com/#author" }
        },
        {
          "@type": "Person",
          "@id": "https://randypellegrini.com/#author",
          "name": "Randy Pellegrini",
          "url": "https://randypellegrini.com",
          "image": "https://randypellegrini.com/images/randypellegrini.jpg",
          "description": "Randy Pellegrini is the author of The Architecture of Survival, an 8-book historical thriller series spanning 3,200 years from Bronze Age Egypt to a near-future synthesis. Six books are published, beginning with The Aethelred Cipher.",
          "jobTitle": "Author",
          "sameAs": [
            "{{ site.xUrl }}",
            "{{ site.substackUrl }}",
            "{{ site.bookbubUrl }}",
            "https://instagram.com/pellegrinirandy",
            "https://www.goodreads.com/author/show/68192892.Randy_Pellegrini",
            "https://www.amazon.com/stores/Randy-Pellegrini/author/B0GMFLQFB3",
            "https://medium.com/@randypellegrini",
            "https://www.bookbub.com/books/the-split-pomegranate-the-architecture-of-survival-book-6-by-randy-pellegrini"
          ],
          "knowsAbout": ["Historical Fiction", "Medieval History", "Genetic Memory", "Conspiracy Thrillers", "Civilizational Collapse"]
        },
        {
          "@type": "BookSeries",
          "@id": "https://randypellegrini.com/#series",
          "name": "The Architecture of Survival",
          "url": "https://randypellegrini.com/series/",
          "author": { "@id": "https://randypellegrini.com/#author" },
          "description": "An 8-book historical thriller saga spanning 3,200 years. Two networks founded in Bronze Age Egypt fight across history over one question: is civilizational collapse preventable through shared knowledge, or inevitable? Each book stands alone.",
          "genre": ["Historical Fiction", "Thriller"]
        }
      ]
    }
    </script>
    {% block pageStyles %}{% endblock %}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page">
      {% include "header.njk" %}
      <div class="site-banner site-banner-preorder" id="site-banner">
        <div class="site-banner-inner">
          <span class="site-banner-text">📖 <strong>Book 6: The Split Pomegranate</strong> is here &mdash; available now on Amazon for $4.99</span>
          <a class="site-banner-cta" href="{{ site.amazonBook6Url }}" target="_blank" rel="noopener noreferrer" data-track="amazon_click" data-book="book6" data-source="banner">Read on Amazon &rarr;</a>
          <button class="site-banner-close" id="banner-close" aria-label="Close banner">&times;</button>
        </div>
      </div>
      <main id="{{ mainId | default('main-content') }}">
        {% block content %}{{ content | safe }}{% endblock %}
      </main>
      {% include "footer.njk" %}
    </div>

    <div id="exit-popup" class="exit-popup-overlay" role="dialog" aria-modal="true" aria-labelledby="exit-popup-title">
      <div class="exit-popup-card">
        <button type="button" id="exit-popup-close" class="exit-popup-close" aria-label="Close">&times;</button>
        <p class="eyebrow" style="color: var(--teal);">Before you go</p>
        <h2 id="exit-popup-title">The pattern runs deeper</h2>
        <p>
          Join the reader list for The Architecture of Survival &mdash; new-release alerts, the real
          history behind the books, and first word on Book 7. About one email a month.
        </p>
        <form data-newsletter="true" class="exit-popup-form">
          <label class="sr-only" for="exit-popup-email">Email address</label>
          <input id="exit-popup-email" type="email" name="email" placeholder="you@email.com" required aria-label="Email address" />
          <button class="button" type="submit"><span>Keep me posted</span></button>
        </form>
        <div class="form-messages" style="display:none"></div>
        <p class="form-note">No spam. Unsubscribe anytime.</p>
      </div>
    </div>

    <script src="/scripts.js"></script>
    <script src="/amazon-localize.js"></script>
    <script src="/analytics.js"></script>
    {% block pageScript %}{% endblock %}
  </body>
</html>
